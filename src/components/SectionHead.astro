---
import TextLink from './TextLink.astro';
// Numbered mono label + big two-line title + optional link on the right.
interface Props { n: string; label: string; title: string[]; link?: { href: string; text: string }; }
const { n, label, title, link } = Astro.props;
---
<div class="mb-12 md:mb-20">
  <p class="label mb-6" data-reveal>({n}) {label}</p>
  <div class="flex flex-col gap-8 md:flex-row md:items-end md:justify-between">
    <h2 class="display text-[3.25rem] sm:text-7xl lg:text-[7.5rem]">
      {title.map((line, i) => <span data-mask style={`--d:${i * 90}ms`}><span>{line}</span></span>)}
    </h2>
    {link && <div data-reveal><TextLink href={link.href}>{link.text}</TextLink></div>}
  </div>
</div>
