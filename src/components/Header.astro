---
import Logo from './Logo.astro';
import Arrow from './Arrow.astro';
import { nav, departures } from '../data/site';
const path = Astro.url.pathname;
const next = departures[0];
// Language selector: the same page in each language (FR/DE/ES pages are written by scripts/i18n.mjs).
const langs = ['en', 'fr', 'de', 'es'].map((l) => ({ l, href: l === 'en' ? path : `/${l}${path}` }));
---
<header class="fixed inset-x-0 top-0 z-50 border-b hair bg-ink-950/80 backdrop-blur-md" data-header>
  <div class="flex h-16 items-stretch md:h-[68px]">
    <div class="flex items-center border-r hair px-4 md:px-10">
      <Logo />
    </div>
    <nav class="hidden flex-1 items-center justify-center gap-8 lg:flex" aria-label="Main">
      {nav.map((l) => (
        <a href={l.href} class:list={['text-[0.9375rem] transition-colors hover:text-snow', path.startsWith(l.href) ? 'text-snow' : 'text-slate-400']}
          aria-current={path.startsWith(l.href) ? 'page' : undefined}>{l.label}</a>
      ))}
    </nav>
    <a href="/#departures" class="hidden items-center gap-3 border-x hair px-6 text-[0.875rem] xl:flex">
      <span class="dot-live h-1.5 w-1.5 rounded-full bg-alpenglow"></span>
      <span>Next · {next.trip.split(':')[0]} · {next.d.split(' — ')[0]} {next.d.split(' ').pop()} · {next.status}</span>
    </a>
    <div class="ml-auto flex items-center gap-3 px-4 md:px-10 lg:ml-0">
      <nav class="langs hidden lg:flex" aria-label="Language" data-i18n-skip>
        {langs.map(({ l, href }, i) => (<>{i > 0 && <span aria-hidden="true">·</span>}<a href={href} hreflang={l} lang={l} data-lang-link aria-current={l === 'en' ? 'true' : undefined}>{l.toUpperCase()}</a></>))}
      </nav>
      <a href="/contact/" class="pill pill-light !py-1.5 !pl-5 !text-sm"><span>Book</span><span class="chip !h-8 !w-8"><Arrow /></span></a>
      <button class="grid h-10 w-10 place-items-center rounded-full border hair lg:hidden" aria-label="Open menu" data-label-open="Open menu" data-label-close="Close menu" aria-expanded="false" aria-controls="menu" data-menu-btn>
        <span class="relative block h-3 w-4">
          <span class="absolute inset-x-0 top-0 h-px bg-snow transition-transform duration-300" data-bar1></span>
          <span class="absolute inset-x-0 bottom-0 h-px bg-snow transition-transform duration-300" data-bar2></span>
        </span>
      </button>
    </div>
  </div>
  <div id="menu" class="pointer-events-none fixed inset-0 top-16 bg-ink-950 opacity-0 transition-opacity duration-500 lg:hidden" data-menu>
    <nav class="wrap flex h-full flex-col pt-10 pb-10" aria-label="Mobile">
      <a href="/" class="display border-b hair py-4 text-5xl">Home</a>
      {nav.map((l) => <a href={l.href} class="display border-b hair py-4 text-5xl">{l.label}</a>)}
      <nav class="langs mt-8" aria-label="Language" data-i18n-skip>
        {langs.map(({ l, href }, i) => (<>{i > 0 && <span aria-hidden="true">·</span>}<a href={href} hreflang={l} lang={l} data-lang-link aria-current={l === 'en' ? 'true' : undefined}>{l.toUpperCase()}</a></>))}
      </nav>
      <p class="label mt-auto">Next · {next.trip} · {next.d} {next.y}</p>
    </nav>
  </div>
</header>
