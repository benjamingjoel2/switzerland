---
import map from '../data/swiss-map.json';
import { destinations } from '../data/destinations';

// Inline SVG map of Switzerland (cantons + lakes) with a pin per destination.
// `linkBase` is '' on the Destinations page (anchors on the same page) or '/destinations/' elsewhere.
interface Props { linkBase?: string; class?: string; }
const { linkBase = '/destinations/', class: cls = '' } = Astro.props;
const pins = destinations.map((d, i) => ({ ...d, n: i + 1, ...map.pins[d.id as keyof typeof map.pins] }));
// Labels sit to the right of the pin unless that would run off the east edge.
const leftLabel = new Set(['st-moritz', 'zurich']);
---
<figure class={`relative ${cls}`} data-map data-reveal>
  <svg viewBox={`0 0 ${map.width} ${map.height}`} class="h-auto w-full overflow-visible" role="img" aria-labelledby="swiss-map-title">
    <title id="swiss-map-title">Map of Switzerland showing Swiss Horizon’s ten destinations</title>
    <defs>
      <clipPath id="ch-clip"><path d={map.country} /></clipPath>
    </defs>
    <path d={map.country} fill="#111A1F" />
    <g clip-path="url(#ch-clip)" fill="#1C3440">
      {map.lakes.map((d) => <path d={d} />)}
    </g>
    <path d={map.cantons} fill="none" stroke="#2A3943" stroke-width="1" stroke-linejoin="round" />
    <path d={map.country} fill="none" stroke="#EEF1EE" stroke-opacity=".7" stroke-width="1.5" stroke-linejoin="round" />

    {pins.map((p, i) => (
      <a href={`${linkBase}#${p.id}`} class="pin group" style={`--i:${i}`} aria-label={`${p.name}, ${p.region}`}>
        <g class="pin-dot" style={`transform-origin:${p.x}px ${p.y}px`}>
          <circle cx={p.x} cy={p.y} r="22" fill="transparent" />
          <circle cx={p.x} cy={p.y} r="15" class="pin-halo" fill="#E0402F" fill-opacity=".22" style={`transform-origin:${p.x}px ${p.y}px`} />
          <circle cx={p.x} cy={p.y} r="11" fill="#E0402F" />
          <text x={p.x} y={p.y + (p.n > 9 ? 3.8 : 4.5)} text-anchor="middle" fill="#0B1114" font-family="JetBrains Mono, monospace" font-size={p.n > 9 ? 10 : 12} font-weight="700">{p.n}</text>
        </g>
        <text
          x={leftLabel.has(p.id) ? p.x - 22 : p.x + 22}
          y={p.y + 6}
          text-anchor={leftLabel.has(p.id) ? 'end' : 'start'}
          class="pin-label hidden fill-snow group-hover:fill-limestone md:block"
          font-size="19"
          font-weight="600"
          letter-spacing="-0.3"
          paint-order="stroke"
          stroke="#0B1114"
          stroke-width="5"
          stroke-linejoin="round"
        >{p.name}</text>
      </a>
    ))}
  </svg>
  <figcaption class="sr-only">Map of Switzerland with pins for {destinations.map((d) => d.name).join(', ')}.</figcaption>

  <ol class="mt-6 grid grid-cols-2 gap-x-6 gap-y-2 text-sm md:hidden">
    {pins.map((p) => (
      <li><a href={`${linkBase}#${p.id}`} class="flex gap-2 text-slate-400 hover:text-snow"><span class="font-mono text-xs text-alpenglow">{String(p.n).padStart(2, '0')}</span>{p.name}</a></li>
    ))}
  </ol>
</figure>
