---
import { Picture } from 'astro:assets';
import { photo, src } from '../lib/media';

// Photos are fetched from Unsplash once at build time, then resized and re-encoded
// (WebP) by Astro and served from this site's own domain.
interface Props {
  photo: string;
  sizes?: string;
  ratio?: number; // height / width; omit to keep the original crop
  widths?: number[];
  class?: string;
  priority?: boolean;
  alt?: string;
}
const { photo: slotName, sizes = '100vw', ratio, widths = [480, 800, 1200, 1600], class: cls = '', priority = false, alt } = Astro.props;
const p = photo(slotName);
const r = ratio ?? p.height / p.width;
const maxW = Math.max(...widths);
const height = Math.round(maxW * r);
---
<Picture
  src={src(p, maxW, r, 85)}
  width={maxW}
  height={height}
  widths={widths}
  sizes={sizes}
  formats={['webp']}
  fallbackFormat="webp"
  quality={priority ? 60 : 55}
  alt={alt ?? p.alt}
  loading={priority ? 'eager' : 'lazy'}
  decoding={priority ? 'sync' : 'async'}
  fetchpriority={priority ? 'high' : 'auto'}
  style={`background-color:${p.color}`}
  pictureAttributes={{ class: 'block h-full w-full' }}
  class={`h-full w-full object-cover ${cls}`}
/>
