---
import SectionHead from '../SectionHead.astro';
import Arrow from '../Arrow.astro';
import { departures } from '../../data/site';
const tone = { low: 'text-alpenglow', open: 'text-glacier', wait: 'text-slate-500' } as const;
const slugOf = (t: string) => t.toLowerCase().includes('glacier') ? 'glacier-express' : t.toLowerCase().includes('rails') ? 'grand-rails' : t.toLowerCase().includes('lucerne') ? 'lucerne' : t.toLowerCase().includes('jungfrau') ? 'jungfrau' : t.toLowerCase().includes('ticino') ? 'ticino' : 'matterhorn';
---
<section class="section border-t hair bg-ink-950" id="departures">
  <div class="wrap">
    <SectionHead n="07" label="Departures" title={['Next', 'departures']} link={{ href: '/contact/', text: 'Ask about private dates' }} />
    <p class="mb-8 max-w-lg text-slate-400" data-reveal>Hold your seat with a 25% deposit. The balance is due 60 days before departure.</p>
    <div class="rounded-md border hair bg-ink-900 p-2 md:p-4" data-reveal>
      <table class="w-full border-collapse text-left">
        <caption class="sr-only">Upcoming departures</caption>
        <thead class="hidden md:table-header-group">
          <tr class="label !text-[0.68rem]">
            <th class="px-4 py-3 font-normal">Dates</th><th class="px-4 py-3 font-normal">Journey</th><th class="px-4 py-3 font-normal">Route</th>
            <th class="px-4 py-3 font-normal">Length</th><th class="px-4 py-3 font-normal">From</th><th class="px-4 py-3 font-normal">Status</th><th class="px-4 py-3"><span class="sr-only">Action</span></th>
          </tr>
        </thead>
        <tbody>
          {departures.map((d) => (
            <tr class="group grid grid-cols-[1fr_auto] gap-x-4 gap-y-1 border-t hair px-3 py-5 transition-colors hover:bg-ink-800/60 md:table-row md:p-0">
              <td class="font-mono text-sm md:px-4 md:py-5"><span class="text-snow">{d.d}</span> <span class="text-slate-500">{d.y}</span></td>
              <td class="col-span-2 row-start-2 md:px-4 md:py-5">
                <span class="font-semibold tracking-tight md:text-lg">{d.trip}</span>
                {d.note && <span class="mt-1 block text-xs text-alpenglow">{d.note}</span>}
              </td>
              <td class="col-span-2 text-sm text-slate-400 md:px-4 md:py-5">{d.place}</td>
              <td class="hidden font-mono text-sm text-slate-400 md:table-cell md:px-4 md:py-5">{d.len}</td>
              <td class="col-start-1 font-mono text-sm md:px-4 md:py-5">{d.price}</td>
              <td class={`col-start-2 row-start-1 text-right font-mono text-sm md:px-4 md:py-5 md:text-left ${tone[d.kind as keyof typeof tone]}`}>
                <span class:list={['mr-2 inline-block h-1.5 w-1.5 rounded-full bg-current align-middle', d.kind === 'low' && 'dot-live']}></span>{d.status}
              </td>
              <td class="col-start-2 row-start-4 text-right md:px-4 md:py-5">
                <a href={`/contact/?journey=${slugOf(d.trip)}`} class="pill pill-ghost !py-1 !pl-4 !text-sm">
                  {d.kind === 'wait' ? 'Join waitlist' : 'Reserve'}<span class="chip !h-7 !w-7"><Arrow size={10} /></span>
                </a>
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </div>
</section>
