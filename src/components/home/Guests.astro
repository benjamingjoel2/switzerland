---
import Arrow from '../Arrow.astro';
import { testimonials, press } from '../../data/site';
---
<section class="section border-t hair bg-ink-900" id="guests">
  <div class="wrap">
    <div class="grid gap-10 lg:grid-cols-12" data-quotes>
      <div class="lg:col-span-3">
        <p class="label" data-reveal>(09) Guests</p>
        <p class="mt-6 text-alpenglow" aria-label="Five stars">★★★★★</p>
      </div>
      <div class="lg:col-span-9">
        <div class="grid">
          {testimonials.map((t, i) => (
            <figure class="quote-slide [grid-area:1/1]" style={i ? 'opacity:0' : ''} aria-hidden={i ? 'true' : 'false'}>
              <blockquote class="headline text-3xl sm:text-4xl lg:text-[3.2rem]">“{t.text}”</blockquote>
              <figcaption class="mt-10">
                <p class="font-semibold">{t.name}</p>
                <p class="font-mono text-xs text-slate-400">{t.trip}</p>
              </figcaption>
            </figure>
          ))}
        </div>
        <div class="mt-12 flex items-center gap-6">
          <p class="font-mono text-sm text-slate-400" data-count aria-live="polite">01 / 03</p>
          <div class="flex gap-2">
            <button data-prev class="grid h-11 w-11 place-items-center rounded-full border hair transition-colors hover:border-snow" aria-label="Previous review"><Arrow dir="w" size={14} /></button>
            <button data-next class="grid h-11 w-11 place-items-center rounded-full border hair transition-colors hover:border-snow" aria-label="Next review"><Arrow dir="e" size={14} /></button>
          </div>
        </div>
      </div>
    </div>
    <div class="mt-24 border-t hair pt-10">
      <p class="label mb-6">As read in</p>
      <ul class="flex flex-wrap items-center justify-between gap-x-10 gap-y-4">
        {press.map((p, i) => <li class:list={['text-xl tracking-tight text-slate-500 md:text-2xl', i % 2 ? 'font-mono !text-lg uppercase' : 'font-semibold italic']}>{p}</li>)}
      </ul>
    </div>
  </div>
</section>
