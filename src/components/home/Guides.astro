---
import Img from '../Img.astro';
import SectionHead from '../SectionHead.astro';
import { guides } from '../../data/site';
---
<section class="section border-t hair" id="guides">
  <div class="wrap">
    <SectionHead n="08" label="Guides" title={['Guides,', 'skippers,', 'cheesemakers']} link={{ href: '/contact/', text: 'Travel with us' }} />
    <div class="grid border-t hair sm:grid-cols-2 lg:grid-cols-4">
      {guides.map((g, i) => (
        <figure class:list={['group pt-6 pb-4 sm:px-5', i % 2 === 1 && 'sm:border-l hair', i === 2 && 'lg:border-l hair', i === 0 && 'sm:pl-0', i === 3 && 'lg:pr-0']} data-reveal style={`--d:${i * 90}ms`}>
          <div class="relative aspect-[3/4] overflow-hidden rounded-sm">
            <div class="img-zoom h-full"><Img photo={g.img} ratio={4 / 3} sizes="(min-width:1024px) 24vw, (min-width:640px) 48vw, 100vw" widths={[400, 640, 900]} /></div>
            <blockquote class="absolute inset-0 flex items-end bg-ink-950/80 p-6 text-xl font-medium leading-snug tracking-tight opacity-0 backdrop-blur-sm transition-opacity duration-500 group-hover:opacity-100 group-focus-within:opacity-100">
              “{g.quote}”
            </blockquote>
          </div>
          <figcaption class="mt-5">
            <p class="text-lg font-semibold tracking-tight">{g.name}</p>
            <p class="font-mono text-xs text-slate-400">{g.role}</p>
            <p class="mt-3 text-sm text-slate-400 lg:hidden">“{g.quote}”</p>
          </figcaption>
        </figure>
      ))}
    </div>
  </div>
</section>
