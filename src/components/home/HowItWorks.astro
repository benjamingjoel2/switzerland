---
import Img from '../Img.astro';
import { steps } from '../../data/site';
---
<section id="how">
  <div class="relative h-[55vh] min-h-[360px] overflow-hidden md:h-[80vh]">
    <div class="absolute inset-0" data-parallax><Img photo="how-banner" sizes="100vw" widths={[640, 1080, 1600, 2200, 2800]} /></div>
    <div class="absolute inset-0 bg-gradient-to-b from-ink-950/30 via-transparent to-ink-950"></div>
  </div>
  <div class="wrap section !pt-12 md:!pt-16">
    <p class="label mb-8" data-reveal>(04) How it works</p>
    <div class="grid gap-10 lg:grid-cols-12">
      <h2 class="display text-5xl sm:text-6xl lg:col-span-7 lg:text-[5.5rem]">
        <span data-mask><span>From first click</span></span><span data-mask style="--d:90ms"><span>to first train.</span></span>
      </h2>
      <p class="max-w-md text-lg text-slate-400 lg:col-span-4 lg:col-start-9 lg:self-end" data-reveal>
        One price covers your rooms, most meals, guides, mountain lifts and a Swiss Travel Pass for the week. You book once and turn up at the station.
      </p>
    </div>
    <ol class="mt-16 grid border-t hair sm:grid-cols-2 lg:grid-cols-4">
      {steps.map((s, i) => (
        <li class:list={['border-b hair py-8 sm:px-6 lg:border-b-0', i % 2 === 1 && 'sm:border-l', i === 2 && 'lg:border-l', i === 0 && 'sm:pl-0']} data-reveal style={`--d:${i * 100}ms`}>
          <p class="flex items-baseline gap-3 font-mono text-xs text-slate-400"><span class="text-alpenglow">{s.n}</span> Step</p>
          <h3 class="mt-10 text-2xl font-semibold tracking-tight">{s.title}</h3>
          <p class="mt-3 text-slate-400">{s.text}</p>
        </li>
      ))}
    </ol>
  </div>
</section>
