---
import Img from '../Img.astro';
import Pill from '../Pill.astro';
import { heroScenes } from '../../data/site';
const s = heroScenes[0];
---
<section class="relative isolate h-[92svh] min-h-[600px] overflow-hidden bg-ink-950" aria-label="Swiss Horizon">
  <div class="absolute inset-0 -z-10">
    <Img photo={s.img} priority full sizes="100vw" widths={[640, 1024, 1600, 2200]} />
  </div>
  <div class="absolute inset-0 -z-10 bg-gradient-to-t from-ink-950/85 via-ink-950/20 to-ink-950/40"></div>

  <div class="wrap flex h-full flex-col justify-end pb-16 md:pb-20">
    <div class="max-w-2xl">
      <p class="label hero-fade mb-5 !text-snow/70">{s.place} · {s.line}</p>
      <h1 class="display text-[clamp(2.5rem,5vw,4.25rem)]">
        <span class="hero-mask"><span>Above the clouds.</span></span>
        <span class="hero-mask" style="--d:120ms"><span class="text-snow/70">On schedule.</span></span>
      </h1>
      <p class="hero-fade mt-6 max-w-md text-lg leading-snug text-snow/90" style="--d:250ms">
        Small-group journeys through the Alps and lakes of Switzerland. Rail-first, hut nights, long lunches — ten guests at most, every train already booked.
      </p>
      <div class="hero-fade mt-8" style="--d:320ms"><Pill href="/destinations/">Explore destinations</Pill></div>
    </div>
  </div>
</section>
