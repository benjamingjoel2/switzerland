---
interface Props { options: string[]; label: string; }
const { options, label } = Astro.props;
---
<div class="mb-10 flex flex-wrap gap-x-6 gap-y-2" role="group" aria-label={label} data-reveal>
  {['All', ...options].map((o, i) => (
    <button data-filter={o} aria-pressed={i === 0 ? 'true' : 'false'}
      class="border-b border-transparent py-1 text-sm text-slate-400 transition-colors hover:text-snow aria-pressed:border-snow aria-pressed:text-snow">{o}</button>
  ))}
</div>
