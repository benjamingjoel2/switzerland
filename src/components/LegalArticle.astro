---
import type { LegalPage } from '../data/legal';
interface Props { page: LegalPage }
const { page } = Astro.props;
const updated = new Date(`${page.updated}T12:00:00Z`).toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' });
---
<section class="section !pt-36 md:!pt-44">
  <div class="wrap grid gap-12 lg:grid-cols-12">
    <div class="lg:col-span-4">
      <p class="label mb-6">Legal</p>
      <h1 class="display text-5xl md:text-7xl">{page.title}</h1>
    </div>
    <div class="legal lg:col-span-7 lg:col-start-6">
      <p class="text-lg text-snow/85">{page.lede}</p>
      <p class="mt-3 text-sm text-slate-500">Last updated <time datetime={page.updated}>{updated}</time>.</p>
      {page.sections.map((s) => (
        <>
          <h2 class="headline mt-12 mb-4 text-2xl">{s.h}</h2>
          {s.p.map((t) => (t.includes('<ul>') ? <div class="mb-4 text-slate-400" set:html={t} /> : <p class="mb-4 text-slate-400" set:html={t} />))}
        </>
      ))}
    </div>
  </div>
</section>
<style>
  .legal :global(a) { text-decoration: underline; text-underline-offset: 2px; }
  .legal :global(ul) { list-style: disc; padding-left: 1.25rem; margin: 0.75rem 0; }
  .legal :global(li) { margin-bottom: 0.4rem; }
  .legal :global(b) { color: var(--color-snow, #fff); font-weight: 500; }
</style>
