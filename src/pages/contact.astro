---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Faq from '../components/Faq.astro';
import Arrow from '../components/Arrow.astro';
import { journeys, departures, brand, faqs } from '../data/site';
const field = 'w-full rounded-sm border hair bg-ink-900 px-4 py-3.5 text-snow placeholder:text-slate-500 transition-colors focus:border-snow focus:outline-none aria-[invalid=true]:border-alpenglow';
const lbl = 'label mb-2 block !text-[0.7rem]';
---
<Base title="Contact & Booking" description="Request a Swiss Horizon journey or ask us anything. Small-group trips through Switzerland with a 25% deposit to hold your seat; a real person in Interlaken replies within one working day." ogSlot="hero-contact">
  <PageHero photo="hero-contact" label="Contact & booking" title={['Hold your', 'seat.']}
    intro="Tell us which journey and when. We’ll confirm availability, room options and the full price within one working day — no payment yet." />

  <section class="section !pt-16 md:!pt-24">
    <div class="wrap grid gap-16 lg:grid-cols-12">
      <div class="lg:col-span-4">
        <p class="label mb-6" data-reveal>(01) Talk to us</p>
        <h2 class="headline text-4xl" data-reveal>A real person in Interlaken answers every message.</h2>
        <dl class="mt-10 space-y-6">
          <div class="border-b hair pb-6" data-reveal><dt class="label !text-[0.68rem]">Email</dt><dd class="mt-2 text-lg"><a class="hover:text-limestone" href={`mailto:${brand.email}`}>{brand.email}</a></dd></div>
          <div class="border-b hair pb-6" data-reveal><dt class="label !text-[0.68rem]">Office hours</dt><dd class="mt-2 text-lg">Mon–Fri, 08:00–18:00 CET</dd></div>
          <div class="border-b hair pb-6" data-reveal><dt class="label !text-[0.68rem]">Base</dt><dd class="mt-2 text-lg">{brand.base}</dd></div>
          <div data-reveal><dt class="label !text-[0.68rem]">How booking works</dt>
            <dd class="mt-3 space-y-2 text-slate-400">
              <p><span class="font-mono text-xs text-alpenglow">01</span> Send the request form.</p>
              <p><span class="font-mono text-xs text-alpenglow">02</span> We confirm seats and send a quote.</p>
              <p><span class="font-mono text-xs text-alpenglow">03</span> A 25% deposit holds your place.</p>
              <p><span class="font-mono text-xs text-alpenglow">04</span> Balance due 60 days before departure.</p>
            </dd>
          </div>
        </dl>
      </div>

      <div class="lg:col-span-7 lg:col-start-6">
        <p class="label mb-6" data-reveal>(02) Booking request</p>
        <form class="grid gap-6 rounded-md border hair bg-ink-900/50 p-5 sm:grid-cols-2 md:p-8" novalidate data-booking data-reveal>
          <div class="sm:col-span-2">
            <label for="journey" class={lbl}>Journey *</label>
            <select id="journey" name="journey" required class={field}>
              <option value="">Choose a journey</option>
              {journeys.map((j) => <option value={j.slug}>{j.title} — from {j.price}</option>)}
              <option value="private">Private or custom trip</option>
            </select>
            <p class="mt-2 hidden text-sm text-alpenglow" data-err="journey">Please choose a journey.</p>
          </div>
          <div class="sm:col-span-2">
            <label for="date" class={lbl}>Preferred departure</label>
            <select id="date" name="date" class={field}>
              <option value="">Any date</option>
              {departures.map((d) => <option>{d.d} {d.y} — {d.trip}</option>)}
            </select>
          </div>
          <div>
            <label for="name" class={lbl}>Full name *</label>
            <input id="name" name="name" required autocomplete="name" class={field} placeholder="Your name" />
            <p class="mt-2 hidden text-sm text-alpenglow" data-err="name">Please tell us your name.</p>
          </div>
          <div>
            <label for="email" class={lbl}>Email *</label>
            <input id="email" name="email" type="email" required autocomplete="email" class={field} placeholder="you@example.com" />
            <p class="mt-2 hidden text-sm text-alpenglow" data-err="email">Please enter a valid email address.</p>
          </div>
          <div>
            <label for="guests" class={lbl}>Guests</label>
            <select id="guests" name="guests" class={field}>{[1, 2, 3, 4, 5, 6].map((n) => <option>{n}</option>)}</select>
          </div>
          <div>
            <label for="room" class={lbl}>Room</label>
            <select id="room" name="room" class={field}><option>Twin share</option><option>Double</option><option>Single (supplement)</option></select>
          </div>
          <div class="sm:col-span-2">
            <label for="message" class={lbl}>Anything we should know?</label>
            <textarea id="message" name="message" rows="4" class={field} placeholder="Dietary needs, fitness, celebrations, questions…"></textarea>
          </div>
          <label class="flex items-start gap-3 text-sm text-slate-400 sm:col-span-2">
            <input type="checkbox" name="terms" required class="mt-1 h-4 w-4 accent-alpenglow" />
            <span>I understand this is a request, not a payment, and agree to be contacted about it. *</span>
          </label>
          <p class="-mt-4 hidden text-sm text-alpenglow sm:col-span-2" data-err="terms">Please tick the box to continue.</p>
          <div class="sm:col-span-2">
            <button type="submit" class="pill pill-light">Send request<span class="chip"><Arrow /></span></button>
          </div>
        </form>
        <div class="rounded-md border border-glacier/40 bg-glacier/5 p-8 md:p-10" hidden tabindex="-1" data-booking-ok role="status">
          <p class="label !text-glacier">Request received</p>
          <p class="headline mt-4 text-4xl">Thank you, <span data-name></span>.</p>
          <p class="mt-4 max-w-md text-slate-400">We’ll check seats and reply within one working day. Meanwhile, have a look at our travel tips.</p>
          <a href="/travel-tips/" class="tlink mt-8">Read the travel tips <span class="arr"><Arrow dir="e" size={13} /></span></a>
        </div>
      </div>
    </div>
  </section>

  <section class="section border-t hair bg-ink-900">
    <div class="wrap grid gap-12 lg:grid-cols-12">
      <div class="lg:col-span-4">
        <p class="label mb-6" data-reveal>(03) Questions</p>
        <h2 class="display text-6xl"><span data-mask><span>Quick</span></span><span data-mask style="--d:90ms"><span>answers</span></span></h2>
      </div>
      <div class="lg:col-span-7 lg:col-start-6"><Faq items={faqs} /></div>
    </div>
  </section>
</Base>
