---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Img from '../components/Img.astro';
import ClosingCta from '../components/ClosingCta.astro';
import { thingGroups } from '../data/things';
---
<Base title="Things to Do in Switzerland" description="The best things to do in Switzerland: Jungfraujoch, Gornergrat, the Glacier Express and Bernina Express, Lake Lucerne steamers, fondue and raclette, Basel Fasnacht and the alpine cattle descent." ogSlot="hero-things">
  <PageHero photo="hero-things" label="Things to do" title={['Peaks, trains,', 'fondue.']}
    intro="Six ways into Switzerland — from Europe’s highest railway station to a 4 a.m. carnival in Basel. Chosen by our guides, tested by our guests." />

  <nav class="sticky top-16 z-30 border-b hair bg-ink-950/90 backdrop-blur md:top-[68px]" aria-label="Sections">
    <div class="wrap flex gap-2 overflow-x-auto py-3 [scrollbar-width:none]">
      {thingGroups.map((g) => <a href={`#${g.id}`} class="shrink-0 rounded-full border hair px-4 py-1.5 text-sm text-slate-400 transition-colors hover:border-snow hover:text-snow"><span class="font-mono text-xs text-alpenglow">{g.n}</span> {g.label}</a>)}
    </div>
  </nav>

  {thingGroups.map((g, gi) => (
    <section id={g.id} class:list={['section scroll-mt-28 border-b hair', gi % 2 === 1 && 'bg-ink-900']}>
      <div class="wrap">
        <div class="mb-12 grid gap-6 lg:grid-cols-12">
          <p class="label lg:col-span-3" data-reveal>({g.n}) {g.label}</p>
          <div class="lg:col-span-9">
            <h2 class="display text-5xl sm:text-6xl lg:text-[5.5rem]"><span data-mask><span>{g.title}</span></span></h2>
            <p class="mt-6 max-w-2xl text-lg text-slate-400" data-reveal>{g.intro}</p>
          </div>
        </div>
        <div class:list={['grid gap-4 sm:grid-cols-2', g.items.length % 3 === 0 ? 'lg:grid-cols-3' : g.items.length === 2 ? '' : 'lg:grid-cols-4']}>
          {g.items.map((t, i) => (
            <article class="group flex flex-col" data-reveal style={`--d:${(i % 4) * 80}ms`}>
              <div class="img-zoom aspect-[4/3] overflow-hidden rounded-sm"><Img photo={t.img} ratio={0.75} sizes="(min-width:1024px) 30vw, (min-width:640px) 48vw, 100vw" widths={[400, 640, 900, 1200]} /></div>
              <p class="mt-5 font-mono text-xs text-slate-400">{t.place}</p>
              <h3 class="mt-2 text-2xl font-semibold leading-tight tracking-[-0.03em]">{t.title}</h3>
              <p class="mt-3 text-slate-400">{t.text}</p>
              <p class="mt-4 border-l-2 border-alpenglow pl-3 text-sm">{t.tip}</p>
            </article>
          ))}
        </div>
        {g.also && (
          <div class="mt-14 border-t hair pt-8">
            <p class="label mb-4">Also worth it</p>
            <ul class="grid gap-3 md:grid-cols-2">{g.also.map((a) => <li class="flex gap-3 text-slate-400"><span class="mt-2.5 h-1 w-3 shrink-0 bg-alpenglow"></span>{a}</li>)}</ul>
          </div>
        )}
      </div>
    </section>
  ))}

  <ClosingCta lines={['All of this,', 'in one week.']} cta="Ask for an itinerary" />
</Base>
